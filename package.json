{
  "name": "moviedle",
  "private": true,
  "version": "0.0.1",
  "description": "Wordle-but-for-movies, as a Discord Activity.",
  "workspaces": [
    "activity"
  ],
  "scripts": {
    "dev": "concurrently -n convex,activity,tunnel -c cyan,green,magenta \"npm:dev:convex\" \"npm:dev:activity\" \"npm:dev:tunnel\"",
    "dev:convex": "convex dev",
    "dev:activity": "npm --workspace activity run dev",
    "dev:tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "convex codegen --typecheck=disable && npm --workspace activity run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && npm --workspace activity run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "convex": "^1.17.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
