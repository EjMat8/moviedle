# Anthropic API key for hint generation (Claude Sonnet 4.6).
# Set with: npx convex env set ANTHROPIC_API_KEY <key>
# This file documents required env vars; Convex secrets are stored in the
# Convex dashboard, not loaded from .env at runtime.
ANTHROPIC_API_KEY=

# Discord OAuth2 secret (used by the Convex HTTP action that exchanges
# the Discord auth code for an access_token in Phase 2+).
# Set with: npx convex env set DISCORD_CLIENT_SECRET <secret>
DISCORD_CLIENT_SECRET=

# Discord application client ID (also needed server-side for token exchange).
# Set with: npx convex env set DISCORD_CLIENT_ID <id>
DISCORD_CLIENT_ID=
